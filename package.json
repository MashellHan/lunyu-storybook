{
  "name": "lunyu-storybook",
  "version": "0.6.0",
  "private": true,
  "description": "动画书：给小朋友的互动论语绘本（学而时习之）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MashellHan/lunyu-storybook.git"
  },
  "homepage": "https://lunyu-picturebook.mxhan.workers.dev",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:single": "node scripts/build.mjs --single",
    "serve": "node scripts/serve.mjs",
    "dev": "npm run build && wrangler dev",
    "preview": "npm run build && wrangler dev --remote",
    "test": "npm run build && npm run build:single && playwright test",
    "test:live": "BASE_URL=https://lunyu-picturebook.mxhan.workers.dev playwright test",
    "check:deploy": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && npm test && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "wrangler": "^4.0.0"
  }
}
