        {
          "term": "由",
          "explanation": "遵循、依照。"
        }
      ]
    },
    "xue-er-12-s04": {
      "meaning": "但只知道和谐可贵，凡事一味求和，也会有行不通的时候。",
      "terms": [
        {
          "term": "知和而和",
          "explanation": "只为求和而求和，不顾应有的原则。"
        },
        {
          "term": "有所不行",
          "explanation": "有行不通的地方。"
        }
      ]
    },
    "xue-er-12-s05": {
      "meaning": "如果不用礼的规范来约束、调节，这样一味求和也行不通。",
      "terms": [
        {
          "term": "节",
          "explanation": "节制、调节，使行为有所分寸。"
        }
      ]
    },
    "xue-er-13-s01": {
      "meaning": "下面是有子说的话；有子名叫有若，是孔子的学生。",
      "terms": [
        {
          "term": "有子",
          "explanation": "对有若的尊称。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-13-s02": {
      "meaning": "许下的诺言合乎应有的道义，才有条件把答应的话做到。",
      "terms": [
        {
          "term": "信",
          "explanation": "此处指约定、承诺。"
        },
        {
          "term": "义",
          "explanation": "做事应当遵循的合宜道理。"
        },
        {
          "term": "复",
          "explanation": "履行诺言，不是再说一遍。"
        }
      ]
    },
    "xue-er-13-s03": {
      "meaning": "他认为，恭敬的态度合乎礼的分寸，就能避免招致羞耻和侮辱。",
      "terms": [
        {
          "term": "恭",
          "explanation": "对人表示敬意。"
        },
        {
          "term": "礼",
          "explanation": "这里指表达敬意时合宜的分寸。"
        },
        {
          "term": "远",
          "explanation": "避开、远离。"
        }
      ]
    },
    "xue-er-13-s04": {
      "meaning": "依靠的人若确实值得亲近，也就可以尊重他、把他当作可靠的依托。",
      "terms": [
        {
          "term": "因",
          "explanation": "依靠、依凭。"
        },
        {
          "term": "亲",
          "explanation": "这里指值得亲近的人，不专指亲戚。"
        },
        {
          "term": "宗",
          "explanation": "尊为主、作为依靠。"
        }
      ]
    },
    "xue-er-14-s01": {
      "meaning": "这里是孔子说的话，孔子是古代的一位老师。",
      "terms": [
        {
          "term": "子",
          "explanation": "对老师等人的尊称，这里指孔子。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-14-s02": {
      "meaning": "君子心有所求，不把吃得饱足、住得安逸当成首要追求。",
      "terms": [
        {
          "term": "食无求饱",
          "explanation": "不以吃得丰足为一心所求，并非要求忍饥挨饿。"
        },
        {
          "term": "居无求安",
          "explanation": "不一味追求住得舒适安逸。"
        }
      ]
    },
    "xue-er-14-s03": {
      "meaning": "做事勤勉，说话谨慎，并向有德行、懂道理的人请教，改正自己的不足。",
      "terms": [
        {
          "term": "敏",
          "explanation": "勤勉、努力，不只是动作快。"
        },
        {
          "term": "就",
          "explanation": "走近、求教。"
        },
        {
          "term": "有道",
          "explanation": "有德行、明白正当道理的人。"
        },
        {
          "term": "正",
          "explanation": "请对方指正自己的是非得失。"
        }
      ]
    },
    "xue-er-14-s04": {
      "meaning": "能够这样做，便可以说是一个真正爱好学习的人了。",
      "terms": [
        {
          "term": "好学",
          "explanation": "喜爱学习，并认真落实到行为中。"
        }
      ]
    },
    "xue-er-15-s01": {
      "meaning": "子贡向孔子发问；子贡名赐，是孔子的学生。",
      "terms": [
        {
          "term": "子贡",
          "explanation": "孔子的学生，姓端木，名赐。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-15-s02": {
      "meaning": "贫穷时不低声讨好，富裕时不自高自大，这样算怎样呢？",
      "terms": [
        {
          "term": "谄",
          "explanation": "卑躬屈膝地讨好别人。"
        },
        {
          "term": "骄",
          "explanation": "自高自大，骄横放纵。"
        },
        {
          "term": "何如",
          "explanation": "怎么样。"
        }
      ]
    },
    "xue-er-15-s03": {
      "meaning": "孔子回答子贡的提问，下面是他的评价。",
      "terms": [
        {
          "term": "子",
          "explanation": "这里指孔子。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-15-s04": {
      "meaning": "这样已经可以了，但还没有达到最好的境界。",
      "terms": [
        {
          "term": "可",
          "explanation": "表示认可，也含还有进步余地。"
        }
      ]
    },
    "xue-er-15-s05": {
      "meaning": "还不如贫穷时仍有内心的安乐、富裕时仍喜爱并遵循礼的人。",
      "terms": [
        {
          "term": "乐",
          "explanation": "心有安乐，不因贫穷而困住自己。"
        },
        {
          "term": "好礼",
          "explanation": "喜欢并乐于遵循合宜的礼。"
        }
      ]
    },
    "xue-er-15-s06": {
      "meaning": "子贡接着回应孔子，并引出《诗》中的一句话。",
      "terms": [
        {
          "term": "子贡",
          "explanation": "孔子的学生，姓端木，名赐。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-15-s07": {
      "meaning": "《诗经》说，像加工骨角玉石那样，切过还要磋，琢过还要磨。",
      "terms": [
        {
          "term": "《诗》",
          "explanation": "指《诗经》；这里引的是《卫风·淇奥》。"
        },
        {
          "term": "如切如磋",
          "explanation": "加工骨角，切过以后还要继续锉磨。"
        },
        {
          "term": "如琢如磨",
          "explanation": "加工玉石，琢过以后还要继续磨细磨光。"
        }
      ]
    },
    "xue-er-15-s08": {
      "meaning": "这句诗大概就是说：有了进步，还要继续把自己修养得更好吧？",
      "terms": [
        {
          "term": "斯",
          "explanation": "这，指上文从不谄不骄再进到安乐、好礼。"
        }
      ]
    },
    "xue-er-15-s09": {
      "meaning": "孔子回应子贡，肯定他对诗句的领悟。",
      "terms": [
        {
          "term": "子",
          "explanation": "这里指孔子。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-15-s10": {
      "meaning": "赐啊，你已经有所领悟，现在可以同你谈《诗》了。",
      "terms": [
        {
          "term": "赐",
          "explanation": "子贡的名，孔子在直接称呼他。"
        },
        {
          "term": "始",
          "explanation": "才，表示由此更进一步。"
        },
        {
          "term": "《诗》",
          "explanation": "指《诗经》。"
        }
      ]
    },
    "xue-er-15-s11": {
      "meaning": "告诉你已经讲过的道理，你就能推想到还没有讲出的意思。",
      "terms": [
        {
          "term": "往",
          "explanation": "已经说过的内容。"
        },
        {
          "term": "来",
          "explanation": "还未说出的内容；不是预知未来。"
        }
      ]
    },
    "xue-er-16-s01": {
      "meaning": "这里是孔子说的话，孔子是古代的一位老师。",
      "terms": [
        {
          "term": "子",
          "explanation": "对老师等人的尊称，这里指孔子。"
        },
        {
          "term": "曰",
          "explanation": "说。"
        }
      ]
    },
    "xue-er-16-s02": {
      "meaning": "不必担心别人不了解自己，应当担心的是自己还不了解别人。",
      "terms": [
        {
          "term": "患",
          "explanation": "忧虑、担心。"
        },
        {
          "term": "不己知",
          "explanation": "不了解自己；己是自己。"
        },
        {
          "term": "知人",
          "explanation": "了解别人的品德和实际情况，辨别是非好坏。"
        }
      ]
    }
  }
}
